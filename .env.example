# .env はサーバーモード（pnpm dev / セルフホスト）でのみ読まれます。
# GitHub Pages などの静的モードでは、設定画面から登録したモデルが localStorage に入ります。
#
# 通常は設定画面（右上のチップ → AI 設定）からモデルを登録してください。
# 以下は「設定画面を使わずに 1 モデルだけ動かす」ための環境変数フォールバックです。
# data/models.json に登録があれば、そちらが優先されます。

# anthropic | openai-compatible
GEOLOGO_PROVIDER=anthropic

# --- anthropic の場合 ---
ANTHROPIC_API_KEY=sk-ant-...
GEOLOGO_MODEL=claude-opus-5
# 宛先を変えるとき（社内プロキシ等）だけ。GEOLOGO_BASE_URL は使われません
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- openai-compatible の場合（さくら AI Engine 等）---
# GEOLOGO_PROVIDER=openai-compatible
# GEOLOGO_BASE_URL=https://api.example.com/v1
# GEOLOGO_API_KEY=...
# GEOLOGO_MODEL=gpt-oss-120b

# API サーバのポート（Vite が /api をここへプロキシ）
GEOLOGO_PORT=8787

# macOS で API キーを Keychain に保存する（data/models.json には metadata のみ残す）
# GEOLOGO_USE_KEYCHAIN=1

# --- 画像モデル（画像方式。絵を先に作らせてから作図へ起こす）---
# 言語モデルとは別系統なので、鍵も別に持ちます。
# さくら AI Engine には画像生成がありません（チャット・埋め込み・音声のみ）。
#
# Google AI Studio は 1 日 500 枚まで無償。鍵を置くだけで画像方式が動きます。
# GOOGLE_GENERATIVE_AI_API_KEY=...
#
# OpenAI を使う場合（従量課金）
# OPENAI_API_KEY=sk-...
#
# 手元の生成器を使う場合（鍵も課金も不要）。PNG を 1 枚書いてくれれば何でも通ります。
# {prompt} {out} {size} が差し替わります。シェルは通さないので引用符は不要です。
# 導入: uv tool install mflux   （M1 Max / 64GB で確認。初回にモデルの重みを取得します）
# FLUX schnell は Hugging Face のログインが要るので、ゲートの無い Z-Image Turbo を既定にしています。
# GEOLOGO_IMAGE_COMMAND=mflux-generate-z-image-turbo --steps 9 -q 8 --width {size} --height {size} --prompt-file {promptFile} --output {out}
#
# 明示したいとき
# GEOLOGO_IMAGE_PROVIDER=google        # google | openai | command（省略時は鍵のあるほう）
# GEOLOGO_IMAGE_MODEL=gemini-2.5-flash-image
# GEOLOGO_IMAGE_SIZE=1024
# GEOLOGO_IMAGE_BASE_URL=https://api.example.com/v1   # openai 互換の宛先
