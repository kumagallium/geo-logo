# .env はサーバーモード（pnpm dev / セルフホスト）でのみ読まれます。
# GitHub Pages などの静的モードでは、設定画面から登録したモデルが localStorage に入ります。
#
# 通常は設定画面（右上のチップ → AI 設定）からモデルを登録してください。
# 以下は「設定画面を使わずに 1 モデルだけ動かす」ための環境変数フォールバックです。
# data/models.json に登録があれば、そちらが優先されます。

# anthropic | openai-compatible
GEOLOGO_PROVIDER=anthropic

# --- anthropic の場合 ---
ANTHROPIC_API_KEY=sk-ant-...
GEOLOGO_MODEL=claude-opus-5
# 宛先を変えるとき（社内プロキシ等）だけ。GEOLOGO_BASE_URL は使われません
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- openai-compatible の場合（さくら AI Engine 等）---
# GEOLOGO_PROVIDER=openai-compatible
# GEOLOGO_BASE_URL=https://api.example.com/v1
# GEOLOGO_API_KEY=...
# GEOLOGO_MODEL=gpt-oss-120b

# API サーバのポート（Vite が /api をここへプロキシ）
GEOLOGO_PORT=8787

# macOS で API キーを Keychain に保存する（data/models.json には metadata のみ残す）
# GEOLOGO_USE_KEYCHAIN=1
