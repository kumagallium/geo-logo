{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "geo-logo",
  "version": "0.1.0",
  "identifier": "com.geologo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "node scripts/fetch-node.mjs && node scripts/bundle-server.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "geo-logo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:8787 ipc: http://ipc.localhost; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/geo-logo-server"
    ],
    "resources": [
      "sidecar/server.mjs",
      "sidecar/node*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://kumagallium.github.io/geo-logo/updater/latest.json",
        "https://github.com/kumagallium/geo-logo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNTA5QjNDMzYzNjZFRTIKUldUaWJqWTJQSnRRa2NHaThMZkN5bHhtSW9oL2taTCtLTW1aN2dNMk1FeVFEKzl2R05ndFNvSjMK"
    }
  }
}
