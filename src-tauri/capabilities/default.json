{
  "identifier": "default",
  "description": "geo-logo デスクトップアプリの既定権限",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/geo-logo-server",
          "sidecar": true
        }
      ]
    },
    "shell:allow-kill",
    "updater:default",
    "process:allow-restart",
    "opener:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:8787/*"
        },
        {
          "url": "http://localhost:8787/*"
        }
      ]
    }
  ]
}
