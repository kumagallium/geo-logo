{
  "identifier": "default",
  "description": "geo-logo デスクトップアプリの既定権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/geo-logo-server", "sidecar": true }]
    },
    "shell:allow-kill",
    "process:allow-restart",
    "opener:default",
    "dialog:default"
  ]
}
